.mine-home-zone,
.mine-guide-zone {
  bottom: 0;
  width: 24%;
  height: 10.5%;
  border-radius: 24rpx;
}

.favorites-zone {
  left: 68.5%;
  top: 30.3%;
  width: 27.5%;
  height: 10.8%;
  border-radius: 24rpx;
}

.favorites-panel,
.favorites-backdrop {
  position: absolute;
  inset: 0;
}

.favorites-panel {
  z-index: 8;
}

.favorites-backdrop {
  background: rgba(13, 50, 47, 0.36);
}

.favorites-sheet {
  position: absolute;
  right: 3.5%;
  bottom: 2.5%;
  left: 3.5%;
  max-height: 58%;
  overflow: auto;
  padding: 34rpx 30rpx 38rpx;
  border: 1rpx solid rgba(34, 91, 83, 0.18);
  border-radius: 28rpx;
  background: rgba(255, 252, 244, 0.98);
  box-shadow: 0 18rpx 45rpx rgba(15, 58, 52, 0.24);
  box-sizing: border-box;
}

.favorites-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.favorites-eyebrow,
.favorites-title,
.favorite-route-name,
.favorite-route-summary {
  display: block;
}

.favorites-eyebrow {
  color: #a77b35;
  font-size: 22rpx;
}

.favorites-title {
  margin-top: 4rpx;
  color: #125851;
  font-size: 38rpx;
  font-weight: 700;
}

.favorites-close {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #e9f0e8;
  color: #195e57;
  font-size: 36rpx;
  line-height: 52rpx;
}

.favorites-close::after,
.favorite-route-item::after {
  border: 0;
}

.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.favorite-route-item {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 24rpx;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(28, 102, 93, 0.16);
  border-radius: 14rpx;
  background: #f8f6ed;
  color: #145a54;
  line-height: 1.3;
  text-align: left;
  box-sizing: border-box;
}

.favorite-route-star {
  color: #edc667;
  font-size: 42rpx;
  text-align: center;
}

.favorite-route-name {
  font-size: 30rpx;
  font-weight: 700;
}

.favorite-route-summary {
  margin-top: 4rpx;
  color: #70827e;
  font-size: 22rpx;
}

.favorite-route-arrow {
  color: #b78335;
  font-size: 40rpx;
}

.favorites-empty {
  display: block;
  padding: 42rpx 12rpx;
  color: #627873;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.mine-home-zone {
  left: 13%;
}

.mine-guide-zone {
  left: 39%;
}

.tap-active {
  background: rgba(30, 102, 96, 0.12);
}
