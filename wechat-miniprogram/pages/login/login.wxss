.consent-zone {
  left: 25.2%;
  top: 83.4%;
  width: 8%;
  height: 4.8%;
  border-radius: 50%;
}

.consent-mark {
  position: absolute;
  left: 50%;
  top: 41%;
  width: 36%;
  aspect-ratio: 1;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #176b62;
}

.consent-check {
  position: absolute;
  left: 50%;
  top: 38%;
  width: 36%;
  height: 52%;
  transform: translate(-50%, -50%) rotate(45deg);
  border-right: 2rpx solid #fff;
  border-bottom: 2rpx solid #fff;
}

.wechat-zone {
  left: 18%;
  top: 65.1%;
  width: 64%;
  height: 5.6%;
  border-radius: 999rpx;
}

.tap-active {
  background: rgba(30, 102, 96, 0.12);
}
