<view class="prototype-page" aria-label="师说古渊亲子探索线导览页">
  <view class="screen-frame" style="{{frameStyle}}">
    <image class="prototype-screen" src="/assets/guide-family.jpg" mode="scaleToFill" aria-label="亲子探索线导览界面" />
    <view class="guide-scenery-motion"></view>
    <image class="guide-ip guide-ip-top" src="/assets/guide-motion/family-ip-top.png" mode="widthFix" />
    <image class="guide-ip guide-ip-bottom" src="/assets/guide-motion/family-ip-bottom.png" mode="widthFix" />
    <view class="map-stations">
      <text class="map-station s1" hover-class="station-active">1 入口牌坊</text><text class="map-station s2" hover-class="station-active">2 古樟问道广场</text><text class="map-station s3" hover-class="station-active">3 水稻工坊</text><text class="map-station s4" hover-class="station-active">4 非遗手作坊</text><text class="map-station s5" hover-class="station-active">5 亲子自然课堂</text><text class="map-station s7" hover-class="station-active">7 文创小集</text><text class="map-station s8" hover-class="station-active">8 叶氏宗祠</text>
    </view>
    <scroll-view class="guide-stops-slider" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="stops-row"><image src="/assets/guide-motion/family-stop-1.jpg" mode="aspectFill" /><image src="/assets/guide-motion/family-stop-2.jpg" mode="aspectFill" /><image src="/assets/guide-motion/family-stop-3.jpg" mode="aspectFill" /><image src="/assets/guide-motion/family-stop-4.jpg" mode="aspectFill" /><image src="/assets/guide-motion/family-stop-2.jpg" mode="aspectFill" /><image src="/assets/guide-motion/family-stop-3.jpg" mode="aspectFill" /></view>
    </scroll-view>
    <view class="tap-zone back-zone" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="返回首页"></view>
    <view class="tap-zone culture-zone" bindtap="goCulture" hover-class="tap-active" aria-role="button" aria-label="切换到文化研学线"></view>
    <view class="tap-zone leisure-zone" bindtap="goLeisure" hover-class="tap-active" aria-role="button" aria-label="切换到休闲体验线"></view>
    <view class="tap-zone favorite-zone" bindtap="toggleFavorite" hover-class="tap-active" aria-role="button" aria-label="收藏亲子探索线">
      <text wx:if="{{isFavorite}}" class="favorite-star">★</text>
    </view>
    <view class="tap-zone start-zone" bindtap="showNavigationNotice" hover-class="tap-active" aria-role="button" aria-label="开始导航"></view>
  </view>
</view>
