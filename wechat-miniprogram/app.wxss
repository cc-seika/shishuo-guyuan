page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #f8f5ed;
}

.prototype-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f8f5ed;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.screen-frame {
  position: relative;
  flex: none;
  overflow: hidden;
  background: #f8f5ed;
}

.prototype-screen {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.tap-zone {
  position: absolute;
  z-index: 2;
  background: rgba(255, 255, 255, 0.001);
}
